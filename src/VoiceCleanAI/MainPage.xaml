<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VoiceCleanAI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VoiceCleanAI"
    xmlns:vm="using:VoiceCleanAI.ViewModels"
    xmlns:core="using:VoiceCleanAI.Core.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:VoiceCleanAI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter" />
        <conv:EmptyCollectionToVisibilityConverter x:Key="EmptyCollectionToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Padding="24,12" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Uid="AppTitle" Text="VoiceClean AI" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="AI Voice Denoise &amp; Enhancement" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="16">
                    <ComboBox ItemsSource="{x:Bind ViewModel.Presets}" 
                              SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                              Header="処理プリセット" Width="200">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="core:ProcessingPreset">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{x:Bind ViewModel.HardwareStatusText, Mode=OneWay}" 
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Advanced Mode Settings -->
        <Border Grid.Row="1" Background="{ThemeResource LayerFillColorSecondaryBrush}" 
                Visibility="{x:Bind ViewModel.IsAdvancedMode, Mode=OneWay}"
                Padding="24,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Width="150">
                    <TextBlock Text="Lambd (強度)" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider Value="{x:Bind ViewModel.ManualLambd, Mode=TwoWay}" Minimum="0" Maximum="1" StepFrequency="0.1" />
                </StackPanel>
                <StackPanel Width="150">
                    <TextBlock Text="Tau (鋭さ)" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider Value="{x:Bind ViewModel.ManualTau, Mode=TwoWay}" Minimum="0" Maximum="1" StepFrequency="0.1" />
                </StackPanel>
                <StackPanel Width="150">
                    <TextBlock Text="NFE (ステップ)" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider Value="{x:Bind ViewModel.ManualNfe, Mode=TwoWay}" Minimum="16" Maximum="256" StepFrequency="16" />
                </StackPanel>
                <StackPanel Width="180">
                    <TextBlock Text="エンコーダー" Style="{StaticResource CaptionTextBlockStyle}" />
                    <ComboBox ItemsSource="{x:Bind ViewModel.Encoders}" SelectedItem="{x:Bind ViewModel.SelectedEncoder, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content (Queue) -->
        <Grid Grid.Row="2" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
            <ListView x:Name="TaskListView" 
                      ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}"
                      Padding="12" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaskViewModel">
                        <Grid Padding="12" Margin="0,4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <FontIcon Grid.Column="0" Glyph="&#xE8D6;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind FileName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8" />
                                <ProgressBar Value="{x:Bind ProgressValue, Mode=OneWay}" Maximum="1" Margin="0,8,0,0" 
                                             Visibility="{x:Bind Status, Converter={StaticResource StatusToVisibilityConverter}, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty State / Drop Hint -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"
                        Visibility="{x:Bind ViewModel.Tasks.Count, Converter={StaticResource EmptyCollectionToVisibilityConverter}, Mode=OneWay}">
                <FontIcon Glyph="&#xE8E5;" FontSize="64" Opacity="0.3" />
                <TextBlock x:Uid="DropHint" Text="ファイルをここにドラッグ＆ドロップして追加" Opacity="0.5" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Bottom Controls -->
        <Border Grid.Row="3" Padding="24,16" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <ProgressBar Value="{x:Bind ViewModel.GlobalProgress, Mode=OneWay}" Maximum="1" MinWidth="200" 
                                 Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay}" />
                    <TextBlock Text="全タスクの処理状況" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" 
                               Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <Button Content="ログ出力" Command="{x:Bind ViewModel.ExportLogsCommand}" />
                    <ToggleSwitch x:Uid="AdvancedToggle" Header="詳細設定" IsOn="{x:Bind ViewModel.IsAdvancedMode, Mode=TwoWay}" Margin="0,0,12,0" />
                    <Button x:Uid="ClearBtn" Content="すべてクリア" Command="{x:Bind ViewModel.ClearCompletedCommand}" />
                    <Button x:Uid="StartBtn" Content="処理開始" Style="{StaticResource AccentButtonStyle}" 
                            Command="{x:Bind ViewModel.StartAllCommand}" Visibility="{x:Bind ViewModel.IsProcessing, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}" />
                    <Button x:Uid="CancelBtn" Content="キャンセル" Command="{x:Bind ViewModel.CancelAllCommand}" 
                            Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
