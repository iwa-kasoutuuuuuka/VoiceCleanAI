<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VoiceCleanAI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:VoiceCleanAI.Converters"
    xmlns:vm="using:VoiceCleanAI.ViewModels"
    xmlns:controls="using:VoiceCleanAI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <Grid RowSpacing="24" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Area -->
        <Grid>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="MainTitle" Text="AI音声クリーニング (AI Voice Cleaning)" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock x:Uid="MainSubtitle" Text="録音からノイズを完全に除去し、スタジオ品質の音声へ。 (Remove noise and enhance voice to studio quality.)" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.7" />
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="8">
                <DropDownButton Content="言語 / Language">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="日本語 (Japanese)" Click="OnLanguageJaClick" />
                            <MenuFlyoutItem Text="English" Click="OnLanguageEnClick" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
                
                <!-- Drop Zone / Task List -->
                <Border Style="{StaticResource SettingsCardStyle}" 
                        AllowDrop="True" 
                        DragOver="OnDragOver" 
                        Drop="OnDrop"
                        MinHeight="200"
                        Background="{ThemeResource SystemControlPageBackgroundChromeLowBrush}">
                    <Grid>
                        <!-- Empty State -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                                    Visibility="{x:Bind ViewModel.Tasks.Count, Mode=OneWay, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0}">
                            <FontIcon Glyph="&#xE8E5;" FontSize="48" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock x:Uid="DropZoneHint" Text="音声ファイルをここにドラッグ＆ドロップ (Drop audio files here)" HorizontalAlignment="Center" />
                            <Button x:Uid="SelectFiles" Content="ファイルを選択 (Select Files)" HorizontalAlignment="Center" Click="OnSelectFilesClick" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>

                        <!-- Task List Area -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.Tasks.Count, Mode=OneWay, Converter={StaticResource InverseIntToVisibilityConverter}, ConverterParameter=0}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskViewModel">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                            CornerRadius="4" Padding="12" Margin="0,0,0,8"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE8D6;" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                            </StackPanel>
                                            
                                            <!-- 波形表示 -->
                                            <controls:WaveformView Grid.Column="2" 
                                                                   WaveformData="{x:Bind WaveformData, Mode=OneWay}" 
                                                                   Height="40" VerticalAlignment="Center" Margin="12,0" />
                                            
                                            <ProgressRing Grid.Column="3" IsActive="{x:Bind IsProcessing, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Processing Options -->
                <TextBlock x:Uid="ProcessingSettings" Text="処理設定 (Processing Settings)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="Preset" Text="プリセット (Presets)" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.Presets}" 
                                      SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedPreset.Description, Mode=OneWay}" 
                                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="OutputSetting" Text="出力設定 (Output Settings)" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <RadioButton x:Uid="SameFolder" Content="元と同じフォルダ (Same as original)" IsChecked="{x:Bind ViewModel.OutputDirectoryMode, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0, Mode=TwoWay}" />
                            <RadioButton x:Uid="CustomFolder" Content="専用フォルダ (Custom Folder)" IsChecked="{x:Bind ViewModel.OutputDirectoryMode, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Bar -->
        <Border Grid.Row="2" Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,12">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsProcessing, Mode=OneWay}" Width="24" Height="24" />
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" VerticalAlignment="Center" />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                    <Button x:Uid="ClearAll" Content="クリア (Clear All)" Click="OnClearClick" />
                    <Button x:Uid="StartProcessing" Content="一括処理を開始 (Start Processing)" Style="{StaticResource AccentButtonStyle}" Click="OnProcessClick" Width="220" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
